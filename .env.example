# SOCIAL POST — FRESH / INDEPENDENT ENVIRONMENT
# Do not copy any Loomic database URL, Supabase key, Meta app credential, or secret here.

# -----------------------------------------------------------------------------
# Supabase PostgreSQL
# LOCAL DEVELOPMENT: use Supavisor Session pooler (port 5432) for both values.
# Supabase Dashboard -> Connect -> ORM -> Prisma -> DIRECT_URL is session mode.
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres"
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres"

# Supabase Storage
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SECRET_KEY=""
# Optional legacy fallback if your project still uses legacy keys:
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="media"

# Create 3 different random values. Never reuse Loomic secrets.
JWT_SECRET="replace-with-a-new-random-secret-at-least-32-chars"
TOKEN_ENCRYPTION_KEY="replace-with-a-different-new-random-secret-at-least-32-chars"
CRON_SECRET="replace-with-a-third-new-random-secret-at-least-32-chars"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Images use the server upload route. Keep small for serverless compatibility.
MAX_UPLOAD_MB=4
# Supabase Free projects currently cap the global upload size at 50 MB.
MAX_VIDEO_UPLOAD_MB=50

# Meta / Instagram API
META_GRAPH_API_VERSION=v26.0
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
INSTAGRAM_REDIRECT_URI="http://localhost:3000/api/oauth/instagram/callback"

# Other providers — optional; leave blank until you create a separate app for each.
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
FACEBOOK_REDIRECT_URI="http://localhost:3000/api/oauth/facebook/callback"

THREADS_CLIENT_ID=""
THREADS_CLIENT_SECRET=""
THREADS_REDIRECT_URI="http://localhost:3000/api/oauth/threads/callback"

LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="http://localhost:3000/api/oauth/linkedin/callback"
LINKEDIN_API_VERSION=202607

X_CLIENT_ID=""
X_CLIENT_SECRET=""
X_REDIRECT_URI="http://localhost:3000/api/oauth/twitter/callback"

PINTEREST_CLIENT_ID=""
PINTEREST_CLIENT_SECRET=""
PINTEREST_REDIRECT_URI="http://localhost:3000/api/oauth/pinterest/callback"

# Never create fake/demo channels in this real fresh project.
ALLOW_DEMO_SOCIAL_CONNECTIONS=false

# Optional AI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6-luna"

# Optional transactional email
RESEND_API_KEY=""
EMAIL_FROM="Social Post <notifications@example.com>"

# Optional location suggestions (Geoapify)
GEOAPIFY_API_KEY=""
LOCATION_SEARCH_COUNTRY_CODE=""
LOCATION_SEARCH_BIAS=""
