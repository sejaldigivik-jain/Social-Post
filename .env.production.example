# SOCIAL POST — PRODUCTION EXAMPLE
# Vercel/serverless: use Supavisor Transaction pooler (6543) for DATABASE_URL.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1"
# Prisma CLI/schema operations: Session pooler (5432).
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SECRET_KEY=""
# Optional legacy fallback if your project still uses legacy keys:
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="media"

JWT_SECRET="NEW_SOCIAL_POST_SECRET"
TOKEN_ENCRYPTION_KEY="NEW_SOCIAL_POST_ENCRYPTION_KEY"
CRON_SECRET="NEW_SOCIAL_POST_CRON_SECRET"

NEXT_PUBLIC_APP_URL="https://YOUR-SOCIAL-POST-DOMAIN"
MAX_UPLOAD_MB=4
MAX_VIDEO_UPLOAD_MB=50

META_GRAPH_API_VERSION=v26.0
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
INSTAGRAM_REDIRECT_URI="https://YOUR-SOCIAL-POST-DOMAIN/api/oauth/instagram/callback"

FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
FACEBOOK_REDIRECT_URI="https://YOUR-SOCIAL-POST-DOMAIN/api/oauth/facebook/callback"
THREADS_CLIENT_ID=""
THREADS_CLIENT_SECRET=""
THREADS_REDIRECT_URI="https://YOUR-SOCIAL-POST-DOMAIN/api/oauth/threads/callback"
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="https://YOUR-SOCIAL-POST-DOMAIN/api/oauth/linkedin/callback"
LINKEDIN_API_VERSION=202607
X_CLIENT_ID=""
X_CLIENT_SECRET=""
X_REDIRECT_URI="https://YOUR-SOCIAL-POST-DOMAIN/api/oauth/twitter/callback"
PINTEREST_CLIENT_ID=""
PINTEREST_CLIENT_SECRET=""
PINTEREST_REDIRECT_URI="https://YOUR-SOCIAL-POST-DOMAIN/api/oauth/pinterest/callback"

ALLOW_DEMO_SOCIAL_CONNECTIONS=false
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6-luna"
RESEND_API_KEY=""
EMAIL_FROM="Social Post <notifications@example.com>"
GEOAPIFY_API_KEY=""
LOCATION_SEARCH_COUNTRY_CODE=""
LOCATION_SEARCH_BIAS=""
